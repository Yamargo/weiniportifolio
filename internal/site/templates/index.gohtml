<a class="btn btn-link" href="https://t.me/+j5zQhgkIkEhjNGRk" target="_blank" rel="noopener noreferrer"><span data-i18n="laos.tg.cta">{{t "laos.tg.cta"}}</span></a>
</article><article class="card reveal">
<div class="card-ico"><img class="flag flag-md" src="{{.Root}}assets/flags/in.svg" alt="" width="36" height="27" decoding="async"></div><h3 class="card-title" data-i18n="laos.g66.title">{{t "laos.g66.title"}}</h3><p data-i18n="laos.g66.body">{{t "laos.g66.body"}}</p>
<a class="btn btn-link" href="https://66gameblog.com" target="_blank" rel="noopener noreferrer"><span data-i18n="laos.g66.cta">{{t "laos.g66.cta"}}</span></a>
</article><article class="card reveal">
<div class="card-ico"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 2.9.8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.300.1-2.700 0 0 .8-.3 2.800 1a9.600 9.600 0 0 1 5 0c1.900-1.300 2.800-1 2.800-1 .5 1.400.2 2.400.1 2.700.6.700 1 1.600 1 2.700 0 3.900-2.400 4.700-4.600 5 .4.300.7.900.7 1.800v2.700c0 .3.2.600.7.500A10 10 0 0 0 12 2Z"/></svg></div><h3 class="card-title" data-i18n="laos.gh.title">{{t "laos.gh.title"}}</h3><p data-i18n="laos.gh.body">{{t "laos.gh.body"}}</p>
<a class="btn btn-primary" href="https://github.com/boomrioseo-dev?tab=repositories" target="_blank" rel="noopener noreferrer"><span data-i18n="laos.gh.cta">{{t "laos.gh.cta"}}</span></a>
</article></div>
