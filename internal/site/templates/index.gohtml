<!doctype html>
<html lang="{{.HTMLLang}}" data-lang="{{.Lang}}"{{if .Fixed}} data-fixed{{end}}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{t "meta.title.home"}} — Vinícius</title>
<meta name="description" content="{{t "meta.description"}}">
<meta name="theme-color" content="#4a0508">
<meta name="color-scheme" content="dark">
<meta property="og:type" content="profile">
<meta property="og:title" content="Vinícius">
<link rel="alternate" hreflang="pt" href="{{.Root}}pt/">
<link rel="alternate" hreflang="en" href="{{.Root}}en/">
<link rel="alternate" hreflang="zh" href="{{.Root}}zh/">
<meta property="og:description" content="{{t "meta.description"}}">
<meta property="og:image" content="{{.Root}}assets/og-image.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="{{.Root}}favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap">
<link rel="stylesheet" href="{{.Root}}css/tokens.css">
<link rel="stylesheet" href="{{.Root}}css/base.css">
<link rel="stylesheet" href="{{.Root}}css/components.css">
<link rel="modulepreload" href="{{.Root}}js/main.js">
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Person", "name": "Vinícius", "jobTitle": "Customer Service Analyst · Service Desk Coordinator", "nationality": {"@type": "Country", "name": "Brazil"}, "knowsLanguage": ["pt", "en", "es", "zh"], "knowsAbout": ["Customer service", "IT support", "Service Desk management", "Graphic design", "SEO", "Paid traffic"], "sameAs": ["https://github.com/boomrioseo-dev"]}</script>
</head>
<body>
<a class="skip-link" href="#main" data-i18n="ui.skip">{{t "ui.skip"}}</a>
<div class="vidbar" role="presentation"><video id="coin-strip" muted loop playsinline preload="metadata" poster="{{.Root}}assets/video/coins-poster.webp" disablepictureinpicture aria-hidden="true" tabindex="-1" width="3840" height="320"><source src="{{.Root}}assets/video/coins-4k.mp4" type="video/mp4"></video></div>
<header class="site-header">
<nav class="site-nav" aria-label="{{t "ui.nav"}}">
<ul class="tabs" role="list"><li><a class="tab" href="#home" data-route-link="home"><img class="cn" src="{{.Root}}assets/img/nav/home.webp" width="163" height="120" alt="{{t "country.home"}}" decoding="async"></a></li><li><a class="tab" href="#laos" data-route-link="laos"><img class="flag" src="{{.Root}}assets/flags/la.svg" alt="" width="28" height="21" decoding="async"><img class="cn" src="{{.Root}}assets/img/nav/la.webp" width="175" height="120" alt="{{t "country.laos"}}" decoding="async"></a></li><li><a class="tab" href="#albania" data-route-link="albania"><img class="flag" src="{{.Root}}assets/flags/al.svg" alt="" width="28" height="21" decoding="async"><img class="cn" src="{{.Root}}assets/img/nav/al.webp" width="256" height="120" alt="{{t "country.albania"}}" decoding="async"></a></li><li><a class="tab" href="#cambodia" data-route-link="cambodia"><img class="flag" src="{{.Root}}assets/flags/kh.svg" alt="" width="28" height="21" decoding="async"><img class="cn" src="{{.Root}}assets/img/nav/kh.webp" width="229" height="120" alt="{{t "country.cambodia"}}" decoding="async"></a></li><li><a class="tab" href="#armenia" data-route-link="armenia"><img class="flag" src="{{.Root}}assets/flags/am.svg" alt="" width="28" height="21" decoding="async"><img class="cn" src="{{.Root}}assets/img/nav/am.webp" width="273" height="120" alt="{{t "country.armenia"}}" decoding="async"></a></li><li><a class="tab" href="#philippines" data-route-link="philippines"><img class="flag" src="{{.Root}}assets/flags/ph.svg" alt="" width="28" height="21" decoding="async"><img class="cn" src="{{.Root}}assets/img/nav/ph.webp" width="244" height="120" alt="{{t "country.philippines"}}" decoding="async"></a></li></ul>
<div class="lang" role="group" aria-label="{{t "ui.lang"}}"><button type="button" data-lang="pt" lang="pt" aria-pressed="false">PT</button><button type="button" data-lang="en" lang="en" aria-pressed="false">EN</button><button type="button" data-lang="zh" lang="zh" aria-pressed="false">中文</button></div>
</nav>
</header>
<main id="main" tabindex="-1">
<article class="view" id="view-home" data-route="home" hidden>
<div class="herobanner"><h1 class="sr-only" tabindex="-1" data-i18n="home.h1">{{t "home.h1"}}</h1>
<img class="hb-one" src="{{.Root}}assets/img/ui/hero.webp" width="790" height="444" alt="{{t "home.hero.alt"}}" fetchpriority="high" decoding="async"></div>
<section class="section" aria-labelledby="intro-h"><div class="explain reveal"><h2 id="intro-h" class="explain-title" data-i18n="home.intro.title">{{t "home.intro.title"}}</h2>
<p data-i18n-html="home.intro.body">{{th "home.intro.body"}}</p>
<ul class="tags" role="list"><li data-i18n="home.skill.0">{{t "home.skill.0"}}</li><li data-i18n="home.skill.1">{{t "home.skill.1"}}</li><li data-i18n="home.skill.2">{{t "home.skill.2"}}</li><li data-i18n="home.skill.3">{{t "home.skill.3"}}</li><li data-i18n="home.skill.4">{{t "home.skill.4"}}</li><li data-i18n="home.skill.5">{{t "home.skill.5"}}</li></ul></div></section>
<section class="section" aria-label="{{t "home.countries"}}"><div class="grid"><a class="card homecard reveal" href="#laos"><img class="flag flag-xl" src="{{.Root}}assets/flags/la.svg" alt="" width="64" height="48" decoding="async"><h3><img class="cn cn-lg" src="{{.Root}}assets/img/nav/la.webp" width="175" height="120" alt="{{t "country.laos"}}" decoding="async"></h3><p data-i18n="home.card.laos">{{t "home.card.laos"}}</p></a><a class="card homecard reveal" href="#albania"><img class="flag flag-xl" src="{{.Root}}assets/flags/al.svg" alt="" width="64" height="48" decoding="async"><h3><img class="cn cn-lg" src="{{.Root}}assets/img/nav/al.webp" width="256" height="120" alt="{{t "country.albania"}}" decoding="async"></h3><p data-i18n="home.card.albania">{{t "home.card.albania"}}</p></a><a class="card homecard reveal" href="#cambodia"><img class="flag flag-xl" src="{{.Root}}assets/flags/kh.svg" alt="" width="64" height="48" decoding="async"><h3><img class="cn cn-lg" src="{{.Root}}assets/img/nav/kh.webp" width="229" height="120" alt="{{t "country.cambodia"}}" decoding="async"></h3><p data-i18n="home.card.cambodia">{{t "home.card.cambodia"}}</p></a><a class="card homecard reveal" href="#armenia"><img class="flag flag-xl" src="{{.Root}}assets/flags/am.svg" alt="" width="64" height="48" decoding="async"><h3><img class="cn cn-lg" src="{{.Root}}assets/img/nav/am.webp" width="273" height="120" alt="{{t "country.armenia"}}" decoding="async"></h3><p data-i18n="home.card.armenia">{{t "home.card.armenia"}}</p></a><a class="card homecard reveal" href="#philippines"><img class="flag flag-xl" src="{{.Root}}assets/flags/ph.svg" alt="" width="64" height="48" decoding="async"><h3><img class="cn cn-lg" src="{{.Root}}assets/img/nav/ph.webp" width="244" height="120" alt="{{t "country.philippines"}}" decoding="async"></h3><p data-i18n="home.card.philippines">{{t "home.card.philippines"}}</p></a></div></section>
</article>
<article class="view" id="view-laos" data-route="laos" hidden>
<header class="hero">
<h1 tabindex="-1"><img class="flag flag-lg" src="{{.Root}}assets/flags/la.svg" alt="" width="44" height="33" decoding="async"><span data-i18n="country.laos">{{t "country.laos"}}</span></h1>
<p data-i18n="laos.lede">{{t "laos.lede"}}</p>
</header><div class="section"><dl class="facts reveal"><div><dt data-i18n="fact.company">{{t "fact.company"}}</dt><dd>STAR COMPANY</dd></div><div><dt data-i18n="fact.role">{{t "fact.role"}}</dt><dd data-i18n="role.csa">{{t "role.csa"}}</dd></div><div><dt data-i18n="fact.period">{{t "fact.period"}}</dt><dd data-i18n="period.khlaos">{{t "period.khlaos"}}</dd></div><div><dt data-i18n="fact.place">{{t "fact.place"}}</dt><dd data-i18n="place.laos">{{t "place.laos"}}</dd></div></dl><aside class="explain reveal"><h3 data-i18n="laos.time.title">{{t "laos.time.title"}}</h3><div data-i18n-html="laos.time.body">{{th "laos.time.body"}}</div></aside></div><section class="section" aria-labelledby="projects-h">
