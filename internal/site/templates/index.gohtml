<article class="view" id="view-albania" data-route="albania" hidden>
<header class="hero">
<h1 tabindex="-1"><img class="flag flag-lg" src="{{.Root}}assets/flags/al.svg" alt="" width="44" height="33" decoding="async"><span data-i18n="country.albania">{{t "country.albania"}}</span></h1>
<p data-i18n="albania.lede">{{t "albania.lede"}}</p>
</header><div class="section"><dl class="facts reveal"><div><dt data-i18n="fact.company">{{t "fact.company"}}</dt><dd>BRILLIANT ENTERTAINMENT</dd></div><div><dt data-i18n="fact.role">{{t "fact.role"}}</dt><dd data-i18n="role.itpt">{{t "role.itpt"}}</dd></div><div><dt data-i18n="fact.period">{{t "fact.period"}}</dt><dd data-i18n="period.al">{{t "period.al"}}</dd></div><div><dt data-i18n="fact.place">{{t "fact.place"}}</dt><dd data-i18n="place.al">{{t "place.al"}}</dd></div></dl><aside class="explain reveal"><h3 data-i18n="albania.time.title">{{t "albania.time.title"}}</h3><div data-i18n-html="albania.time.body">{{th "albania.time.body"}}</div></aside><aside class="explain reveal"><h3 data-i18n="albania.about.title">{{t "albania.about.title"}}</h3><div data-i18n-html="albania.about.body">{{th "albania.about.body"}}</div></aside></div><section class="section" aria-labelledby="banners-h">
