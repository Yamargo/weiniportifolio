<div id="announcer" class="sr-only" role="status" aria-live="polite"></div>
<dialog id="lightbox" class="lightbox" aria-label="{{t "ui.zoom"}}">
<form method="dialog"><button class="lb-btn lb-close" aria-label="{{t "ui.close"}}" data-i18n-aria="ui.close">×</button></form>
<button type="button" class="lb-btn lb-prev" aria-label="{{t "ui.prev"}}" data-i18n-aria="ui.prev">‹</button>
<img alt="" decoding="async">
<button type="button" class="lb-btn lb-next" aria-label="{{t "ui.next"}}" data-i18n-aria="ui.next">›</button>
<p class="lb-cap"></p>
</dialog>
<noscript><style>.view[hidden]{display:block}.reveal{opacity:1!important;transform:none!important}</style></noscript>
<script type="module" src="{{.Root}}js/main.js"></script>
